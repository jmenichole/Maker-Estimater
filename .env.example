# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Base URL (optional)
# Use this to route requests through an AI Gateway for caching and analytics
# Examples:
# - Vercel AI Gateway: https://gateway.vercel.com/v1/openai
# - Cloudflare AI Gateway: https://gateway.ai.cloudflare.com/v1/your-account-id/your-gateway-id/openai
# - Default (if not set): https://api.openai.com/v1
OPENAI_BASE_URL=
