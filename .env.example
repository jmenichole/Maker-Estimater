# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Vercel AI Gateway URL (optional)
# Use this to route requests through Vercel's AI Gateway for caching and analytics
# Format: https://gateway.ai.cloudflare.com/v1/your-account-id/your-gateway-id/openai
VERCEL_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/vercel/openai
